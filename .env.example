# ==============================================================================
# The Inconvenient Vault (Vault-404) Environment Configuration
# ==============================================================================

# Actual vault keypad password
VAULT_PASSWORD=

# Hardware Mode: REAL (Physical ESP32) or SIMULATED (Virtual mock)
VAULT_HARDWARE_MODE=SIMULATED

# Optional explicit serial port for ESP32 (leave blank for auto-discovery)
# VAULT_SERIAL_PORT=COM3

# Database connection URL
VAULT_DB_URL=sqlite+aiosqlite:///vault.db
